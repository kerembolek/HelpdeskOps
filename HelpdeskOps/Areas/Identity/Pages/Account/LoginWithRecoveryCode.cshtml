@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Kurtarma Koduyla Giriş";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <span class="icon-box bg-primary-subtle text-primary-emphasis mb-2"><i class="bi bi-life-preserver"></i></span>
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                </div>
                <p class="text-muted small text-center">2FA'yı açarken kaydettiğiniz kurtarma kodlarından birini girin. Her kod bir kez kullanılabilir.</p>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Kurtarma kodu" />
                        <label asp-for="Input.RecoveryCode" class="form-label"></label>
                        <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Giriş Yap</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
