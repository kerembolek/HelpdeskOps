@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Doğrulama E-postası";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <span class="icon-box bg-primary-subtle text-primary-emphasis mb-2"><i class="bi bi-envelope"></i></span>
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                </div>
                <p class="text-muted small text-center">Doğrulama e-postası size ulaşmadıysa adresinizi yazın, yeniden gönderelim.</p>
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger small" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="ad@sirket.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Yeniden Gönder</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
