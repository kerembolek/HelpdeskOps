@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Hesabınızı Doğrulayın";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <span class="icon-box bg-primary-subtle text-primary-emphasis mb-2"><i class="bi bi-envelope-check"></i></span>
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                </div>
                <p class="text-center mb-0">Kayıt tamamlandı. <strong>@Model.Email</strong> adresine bir doğrulama bağlantısı gönderdik; bağlantıya tıkladıktan sonra giriş yapabilirsiniz.</p>
            </div>
        </div>
    </div>
</div>
