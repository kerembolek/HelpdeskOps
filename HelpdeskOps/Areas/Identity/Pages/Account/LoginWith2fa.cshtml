@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulama";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <span class="icon-box bg-primary-subtle text-primary-emphasis mb-2"><i class="bi bi-shield-lock"></i></span>
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                </div>
                <p class="text-muted small text-center">Telefonunuzdaki doğrulama uygulamasının gösterdiği 6 haneli kodu girin.</p>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <input asp-for="RememberMe" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" placeholder="Kod" />
                        <label asp-for="Input.TwoFactorCode" class="form-label"></label>
                        <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMachine" />
                        <label class="form-check-label" asp-for="Input.RememberMachine"></label>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Giriş Yap</button>
                </form>
                <p class="text-center small mt-3 mb-0">
                    Telefonunuza ulaşamıyor musunuz?
                    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Kurtarma koduyla girin</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
