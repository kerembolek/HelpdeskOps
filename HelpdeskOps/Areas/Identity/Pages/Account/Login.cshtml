@page
@model LoginModel
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

@{
    ViewData["Title"] = "Giriş Yap";
    var readOnlyDemo = HelpdeskOps.Services.DemoReadOnlyMiddleware.IsEnabled(Configuration);
    var showDemoAccounts = Environment.IsDevelopment() || Configuration.GetValue<bool>("SeedDemoData");
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <span class="icon-box bg-primary-subtle text-primary-emphasis mb-2"><i class="bi bi-headset"></i></span>
                    <h1 class="h3 mb-1">Giriş Yap</h1>
                    <p class="text-muted small mb-0">HelpdeskOps hesabınızla oturum açın.</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ad@sirket.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="parola" />
                        <label asp-for="Input.Password" class="form-label"></label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                    </button>
                </form>

                @* The read-only demo has no registration; password reset needs e-mail, which this app does not send *@
                @if (!readOnlyDemo)
                {
                    <p class="text-center small mt-3 mb-0">
                        Hesabınız yok mu? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Kayıt olun</a>
                    </p>
                }
            </div>
        </div>

        @if (showDemoAccounts)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="fw-semibold mb-1"><i class="bi bi-person-badge me-1 text-primary"></i> Demo hesapla dene</div>
                    <p class="small text-muted mb-2">Bir rol seçin, bilgiler forma doldurulsun.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-demo-email="test@helpdeskops.com">Çalışan</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-demo-email="it@helpdeskops.com">BT Uzmanı</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-demo-email="mudur@helpdeskops.com">Yönetici</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (showDemoAccounts)
    {
        <script>
            // Demo buttons fill the form with a published demo account; the visitor still presses "Giriş Yap"
            document.querySelectorAll('[data-demo-email]').forEach(function (button) {
                button.addEventListener('click', function () {
                    document.getElementById('Input_Email').value = button.dataset.demoEmail;
                    document.getElementById('Input_Password').value = '@HelpdeskOps.Data.DemoDataSeeder.DemoPassword';
                    document.getElementById('login-submit').focus();
                });
            });
        </script>
    }
}
