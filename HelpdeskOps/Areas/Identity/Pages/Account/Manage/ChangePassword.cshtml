@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="h4">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-muted small">Yeni şifre en az 10 karakter olmalı; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</p>
<form id="change-password-form" method="post" style="max-width: 28rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Mevcut şifre" />
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Yeni şifre" />
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Yeni şifre (tekrar)" />
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
