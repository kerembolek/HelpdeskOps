@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulama";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h4">@ViewData["Title"]</h2>
<p class="text-muted small">Girişte şifrenizin yanında telefonunuzdaki doğrulama uygulamasının ürettiği 6 haneli kod da istenir. Şifreniz ele geçirilse bile hesabınız korunur.</p>

@if (Model.Is2faEnabled)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-shield-check"></i> İki adımlı doğrulama açık.</div>

    if (Model.RecoveryCodesLeft == 0)
    {
        <div class="alert alert-danger">
            <strong>Kurtarma kodunuz kalmadı.</strong>
            Kurtarma koduyla giriş yapabilmek için <a asp-page="./GenerateRecoveryCodes">yeni kurtarma kodları oluşturun</a>.
        </div>
    }
    else if (Model.RecoveryCodesLeft <= 3)
    {
        <div class="alert alert-warning">
            <strong>@Model.RecoveryCodesLeft kurtarma kodunuz kaldı.</strong>
            <a asp-page="./GenerateRecoveryCodes">Yeni kurtarma kodları oluşturun</a>.
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (Model.IsMachineRemembered)
        {
            <form method="post">
                <button type="submit" class="btn btn-outline-secondary">Bu tarayıcıyı unut</button>
            </form>
        }
        <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary">Kurtarma kodlarını yenile</a>
        <a asp-page="./Disable2fa" class="btn btn-outline-danger">İki adımlı doğrulamayı kapat</a>
    </div>
}

<h3 class="h5">Doğrulama uygulaması</h3>
@if (!Model.HasAuthenticator)
{
    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary"><i class="bi bi-phone me-1"></i>Doğrulama uygulaması ekle</a>
}
else
{
    <div class="d-flex flex-wrap gap-2">
        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Uygulamayı yeniden kur</a>
        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-danger">Uygulama anahtarını sıfırla</a>
    </div>
}
