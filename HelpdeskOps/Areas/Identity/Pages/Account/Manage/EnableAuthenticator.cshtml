@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Doğrulama Uygulamasını Kur";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h4">@ViewData["Title"]</h2>
<ol class="mt-3">
    <li class="mb-3">
        Telefonunuza Microsoft Authenticator ya da Google Authenticator gibi bir doğrulama uygulaması kurun.
    </li>
    <li class="mb-3">
        Uygulamada yeni hesap ekleyip bu QR kodu okutun. Okutamıyorsanız şu anahtarı elle girin:
        <kbd>@Model.SharedKey</kbd> (boşluklar ve büyük/küçük harf fark etmez).
        <div class="mt-3 p-2 bg-white border rounded d-inline-block" style="width: 13rem;" aria-label="Doğrulama QR kodu">
            @Html.Raw(Model.QrCodeSvg)
        </div>
    </li>
    <li>
        Uygulamanın gösterdiği 6 haneli kodu aşağıya yazın.
        <form id="send-code" method="post" class="mt-2" style="max-width: 20rem;">
            <div class="form-floating mb-3">
                <input asp-for="Input.Code" class="form-control" autocomplete="off" inputmode="numeric" placeholder="Kod" />
                <label asp-for="Input.Code" class="form-label"></label>
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Doğrula ve Aç</button>
            <div asp-validation-summary="ModelOnly" class="text-danger small mt-2" role="alert"></div>
        </form>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
