@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Kurtarma Kodlarını Yenile";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h4">@ViewData["Title"]</h2>
<div class="alert alert-warning" role="alert">
    Yeni kodlar oluşturulunca eski kurtarma kodları geçersiz olur. Doğrulama uygulamanız aynı şekilde çalışmaya devam eder;
    uygulamanın anahtarını değiştirmek için <a asp-page="./ResetAuthenticator">uygulama anahtarını sıfırlayın</a>.
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">Yeni Kodlar Oluştur</button>
</form>
