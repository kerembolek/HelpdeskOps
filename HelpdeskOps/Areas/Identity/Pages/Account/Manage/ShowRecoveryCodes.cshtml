@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Kurtarma Kodları";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h4">@ViewData["Title"]</h2>
<div class="alert alert-warning" role="alert">
    <strong>Bu kodları güvenli bir yere kaydedin.</strong>
    Telefonunuzu kaybederseniz hesabınıza ancak bu kodlarla girebilirsiniz. Her kod bir kez kullanılabilir.
</div>
<div class="row row-cols-2 g-2" style="max-width: 24rem;">
    @foreach (var code in Model.RecoveryCodes ?? Array.Empty<string>())
    {
        <div class="col"><code class="recovery-code fs-6">@code</code></div>
    }
</div>
