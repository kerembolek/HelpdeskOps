@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Uygulama Anahtarını Sıfırla";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h4">@ViewData["Title"]</h2>
<div class="alert alert-warning" role="alert">
    Anahtar sıfırlanınca telefonunuzdaki doğrulama uygulaması çalışmaz ve iki adımlı doğrulama kapanır.
    Yeni anahtarla uygulamayı yeniden kurana kadar hesabınız yalnızca şifreyle korunur.
</div>
<form id="reset-authenticator-form" method="post">
    <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Anahtarı Sıfırla</button>
</form>
