@page
@model Disable2faModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulamayı Kapat";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h4">@ViewData["Title"]</h2>
<div class="alert alert-warning" role="alert">
    Girişte artık yalnızca şifreniz istenir. Doğrulama uygulamanızdaki anahtar değişmez; daha sonra tekrar açabilirsiniz.
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">Kapat</button>
</form>
