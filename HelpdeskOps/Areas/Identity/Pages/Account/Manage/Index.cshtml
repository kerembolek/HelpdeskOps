@page
@model IndexModel
@{
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="h4">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="profile-form" method="post" style="max-width: 28rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Username" class="form-control" placeholder="E-posta" disabled />
        <label asp-for="Username" class="form-label">E-posta</label>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Telefon" />
        <label asp-for="Input.PhoneNumber" class="form-label"></label>
        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
    </div>
    <button id="update-profile-button" type="submit" class="btn btn-primary">Kaydet</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
