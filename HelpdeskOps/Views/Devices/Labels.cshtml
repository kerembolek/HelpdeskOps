@model List<HelpdeskOps.Models.DeviceLabel>

@{
    // A bare page, so the browser prints only the stickers
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cihaz Etiketleri - HelpdeskOps</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        /* Sized for A4 sheets of 21 stickers (3 x 7, 63.5 x 38.1 mm), the most common office label size */
        @@page { size: A4; margin: 15mm 7mm; }
        .sheet { display: grid; grid-template-columns: repeat(3, 63.5mm); grid-auto-rows: 38.1mm; column-gap: 2.5mm; }
        .label { display: flex; align-items: center; gap: 2mm; padding: 2mm; border: 1px dashed #bbb; overflow: hidden; break-inside: avoid; }
        .label .qr { flex: 0 0 30mm; width: 30mm; height: 30mm; }
        .label .qr svg { width: 100%; height: 100%; }
        .label .text { font-size: 8pt; line-height: 1.25; min-width: 0; }
        .label .host { font-size: 10pt; font-weight: 700; word-break: break-all; }
        @@media print {
            .no-print { display: none !important; }
            .label { border-color: transparent; }
        }
    </style>
</head>
<body class="p-3">
    <div class="no-print mb-3">
        <h1 class="h4">Cihaz Etiketleri</h1>
        <p class="text-muted mb-2">
            @Model.Count etiket. Etiketi okutan çalışan o cihaz için talep açar, BT ise cihaz kartını görür.
            A4 boyutunda 21'li (63,5 x 38,1 mm) etiket kâğıdına, ölçeklendirme kapalıyken (%100) yazdırın.
        </p>
        <button type="button" class="btn btn-primary" onclick="window.print()">Yazdır</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cihazlara Dön</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info no-print">Etiket basılacak cihaz bulunmuyor.</div>
    }
    else
    {
        <div class="sheet">
            @foreach (var label in Model)
            {
                <div class="label">
                    <div class="qr">@Html.Raw(label.QrSvg)</div>
                    <div class="text">
                        <div class="host">@label.Device.Hostname</div>
                        <div>Seri No: @label.Device.SerialNumber</div>
                        <div class="mt-1">Sorun mu var? Okutun, talep açın.</div>
                    </div>
                </div>
            }
        </div>
    }
</body>
</html>
