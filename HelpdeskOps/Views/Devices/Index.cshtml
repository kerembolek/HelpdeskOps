@model IEnumerable<HelpdeskOps.Models.Device>
@using HelpdeskOps.Models.Enums

@{
    ViewData["Title"] = "Cihazlar";
    var warranty = ViewBag.Warranty as string;
}

<h1>Cihazlar</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Cihaz Ekle</a>
    <a asp-action="Import" class="btn btn-outline-primary ms-2">CSV'den İçe Aktar</a>
    <a asp-action="Export" class="btn btn-outline-secondary ms-2">CSV Olarak Dışa Aktar</a>
</p>

@if (TempData["DeviceMessage"] is string deviceMessage)
{
    <div class="alert alert-success">@deviceMessage</div>
}

@if (ViewBag.PendingReturns is List<HelpdeskOps.Models.AssignmentForm> pendingReturns && pendingReturns.Any())
{
    <div class="alert alert-warning">
        <strong>İade bekleyen @pendingReturns.Count cihaz var.</strong> Cihazı teslim aldığınızda kontrol edip imzalayın:
        <ul class="mb-0 mt-1">
            @foreach (var form in pendingReturns)
            {
                <li>
                    <a asp-controller="AssignmentForms" asp-action="CheckIn" asp-route-id="@form.Id">@form.Hostname</a>
                    <span class="text-muted">· @form.EmployeeName · @form.ReturnReason?.GetDisplayName() · @form.ReturnRequestedAt?.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</span>
                </li>
            }
        </ul>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label for="warranty" class="form-label small text-muted mb-1">Garanti</label>
        <select id="warranty" name="warranty" class="form-select">
            <option value="">Tüm cihazlar</option>
            <option value="expiring" selected="@(warranty == "expiring")">@HelpdeskOps.Models.Device.WarrantyExpiringSoonDays gün içinde bitecekler</option>
            <option value="expired" selected="@(warranty == "expired")">Garantisi bitmiş</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrele</button>
        @if (warranty != null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        }
    </div>
    @if (Model.Any())
    {
        <div class="col-md text-md-end">
            <button type="button" class="btn btn-outline-secondary" data-ping-refresh>Ağ Durumunu Yenile</button>
        </div>
    }
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(warranty != null ? "Filtreye uyan cihaz bulunamadı." : "Henüz kayıtlı cihaz bulunmuyor.")
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Cihaz Adı</th>
                <th>IP Adresi</th>
                <th>Seri No</th>
                <th>Tür</th>
                <th>Durum</th>
                <th>Garanti Bitişi</th>
                <th>Zimmetli</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-nowrap">@item.Hostname</td>
                    <td class="text-nowrap"><partial name="_PingDot" model="item" />@item.IpAddress</td>
                    <td>@item.SerialNumber</td>
                    <td>@Html.DisplayFor(modelItem => item.DeviceType)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    <td><partial name="_WarrantyBadge" model="item" /></td>
                    <td>@(item.AssignedUser != null ? item.AssignedUser.FirstName + " " + item.AssignedUser.LastName : "Atanmamış")</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id">Detay</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                        @if (item.SupportsRemoteDesktop())
                        {
                            <text> | </text><a asp-action="Rdp" asp-route-id="@item.Id" title="Uzak Masaüstü bağlantı dosyasını indir">RDP</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}