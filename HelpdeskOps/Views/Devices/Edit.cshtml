@using HelpdeskOps.Models.Enums
@model HelpdeskOps.Models.Device

@{
    ViewData["Title"] = "Cihazı Düzenle";
}

<h1>Cihazı Düzenle</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="AssignedUserId" />

            <div class="form-group mb-3">
                <label asp-for="Hostname" class="control-label">Cihaz Adı</label>
                <input asp-for="Hostname" class="form-control" />
                <span asp-validation-for="Hostname" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="IpAddress" class="control-label">IP Adresi</label>
                <input asp-for="IpAddress" class="form-control" />
                <span asp-validation-for="IpAddress" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SerialNumber" class="control-label">Seri No</label>
                <input asp-for="SerialNumber" class="form-control" />
                <span asp-validation-for="SerialNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Brand" class="control-label">Marka</label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Model" class="control-label">Model</label>
                <input asp-for="Model" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="DeviceType" class="control-label">Tür</label>
                <select asp-for="DeviceType" asp-items="Html.GetEnumSelectList<DeviceType>()" class="form-control"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">Durum</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<DeviceStatus>()" class="form-control"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="WarrantyEndDate" class="control-label">Garanti Bitişi</label>
                <input asp-for="WarrantyEndDate" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}