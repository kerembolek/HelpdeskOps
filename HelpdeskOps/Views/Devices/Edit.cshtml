@using HelpdeskOps.Models.Enums
@model HelpdeskOps.Models.Device

@{
    ViewData["Title"] = "Cihazı Düzenle";
}

<h1>Cihazı Düzenle</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Hostname" class="control-label">Cihaz Adı</label>
                <input asp-for="Hostname" class="form-control" />
                <span asp-validation-for="Hostname" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="IpAddress" class="control-label">IP Adresi</label>
                <input asp-for="IpAddress" class="form-control" />
                <span asp-validation-for="IpAddress" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SerialNumber" class="control-label">Seri No</label>
                <input asp-for="SerialNumber" class="form-control" />
                <span asp-validation-for="SerialNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Brand" class="control-label">Marka</label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Model" class="control-label">Model</label>
                <input asp-for="Model" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="DeviceType" class="control-label">Tür</label>
                <select asp-for="DeviceType" asp-items="Html.GetEnumSelectList<DeviceType>()" class="form-select"></select>
                <span asp-validation-for="DeviceType" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">Durum</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<DeviceStatus>()" class="form-select"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PurchaseDate" class="control-label"></label>
                <input asp-for="PurchaseDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="WarrantyEndDate" class="control-label">Garanti Bitişi</label>
                <input asp-for="WarrantyEndDate" class="form-control" />
                <span asp-validation-for="WarrantyEndDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VendorName" class="control-label"></label>
                <input asp-for="VendorName" class="form-control" placeholder="Örn. Lenovo Yetkili Servis" />
                <span asp-validation-for="VendorName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VendorPhone" class="control-label"></label>
                <input asp-for="VendorPhone" class="form-control" />
                <span asp-validation-for="VendorPhone" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VendorEmail" class="control-label"></label>
                <input asp-for="VendorEmail" class="form-control" />
                <span asp-validation-for="VendorEmail" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AssignedUserId" class="control-label">Zimmetli Kullanıcı</label>
                <select asp-for="AssignedUserId" asp-items="ViewBag.Users" class="form-select">
                    <option value="">Atanmamış</option>
                </select>
                <span asp-validation-for="AssignedUserId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SwitchId" class="control-label"></label>
                <select asp-for="SwitchId" asp-items="ViewBag.Switches" class="form-select">
                    <option value="">Bağlı değil</option>
                </select>
                <span asp-validation-for="SwitchId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SwitchPort" class="control-label"></label>
                <input asp-for="SwitchPort" class="form-control" placeholder="Örn. Gi1/0/12" />
                <span asp-validation-for="SwitchPort" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VlanId" class="control-label"></label>
                <input asp-for="VlanId" class="form-control" min="1" max="4094" />
                <span asp-validation-for="VlanId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}