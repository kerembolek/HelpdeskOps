@model HelpdeskOps.Models.Device

@{
    ViewData["Title"] = "Cihaz Detayı";
}

<h1>Cihaz Detayı</h1>

<hr />
<dl class="row">
    <dt class="col-sm-3">Cihaz Adı</dt>
    <dd class="col-sm-9">@Model.Hostname</dd>

    <dt class="col-sm-3">IP Adresi</dt>
    <dd class="col-sm-9">@Model.IpAddress</dd>

    <dt class="col-sm-3">Seri No</dt>
    <dd class="col-sm-9">@Model.SerialNumber</dd>

    <dt class="col-sm-3">Marka</dt>
    <dd class="col-sm-9">@Model.Brand</dd>

    <dt class="col-sm-3">Model</dt>
    <dd class="col-sm-9">@Model.Model</dd>

    <dt class="col-sm-3">Tür</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.DeviceType)</dd>

    <dt class="col-sm-3">Durum</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>

    <dt class="col-sm-3">Satın Alma Tarihi</dt>
    <dd class="col-sm-9">@(Model.PurchaseDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

    <dt class="col-sm-3">Garanti Bitişi</dt>
    <dd class="col-sm-9"><partial name="_WarrantyBadge" model="Model" /></dd>

    <dt class="col-sm-3">Servis / Tedarikçi</dt>
    <dd class="col-sm-9">
        @if (string.IsNullOrEmpty(Model.VendorName) && string.IsNullOrEmpty(Model.VendorPhone) && string.IsNullOrEmpty(Model.VendorEmail))
        {
            <span class="text-muted">-</span>
        }
        else
        {
            <div>@Model.VendorName</div>
            @if (!string.IsNullOrEmpty(Model.VendorPhone))
            {
                <div><a href="tel:@Model.VendorPhone">@Model.VendorPhone</a></div>
            }
            @if (!string.IsNullOrEmpty(Model.VendorEmail))
            {
                <div><a href="mailto:@Model.VendorEmail">@Model.VendorEmail</a></div>
            }
        }
    </dd>

    <dt class="col-sm-3">Zimmetli Kullanıcı</dt>
    <dd class="col-sm-9">
        @(Model.AssignedUser != null
            ? $"{Model.AssignedUser.FirstName} {Model.AssignedUser.LastName}"
            : "Atanmamış")
    </dd>

    <dt class="col-sm-3">Oluşturulma Tarihi</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Son Güncelleme</dt>
    <dd class="col-sm-9">@Model.LastUpdated.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Düzenle</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Listeye Dön</a>
</div>

<section id="history" class="mt-5" style="max-width: 48rem;">
    <h2 class="h4">Cihaz Geçmişi</h2>
    <p class="text-muted small">Format, yükseltme, parça değişimi ve bakım kayıtları ile zimmet ve durum değişiklikleri.</p>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">Bu cihaz için henüz kayıtlı bir işlem yok.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var item in Model.Events)
            {
                var isAutomatic = item.Type is HelpdeskOps.Models.Enums.DeviceEventType.AssignmentChanged
                    or HelpdeskOps.Models.Enums.DeviceEventType.StatusChanged;
                <li class="list-group-item px-0">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>
                            <span class="badge @(isAutomatic ? "text-bg-light border" : "text-bg-primary")">@Html.DisplayFor(_ => item.Type)</span>
                            <span class="ms-1">@(item.PerformedBy != null ? $"{item.PerformedBy.FirstName} {item.PerformedBy.LastName}" : "Sistem")</span>
                        </span>
                        <span>@item.EventDate.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                    <div style="white-space: pre-line;">@item.Description</div>
                </li>
            }
        </ul>
    }

    <form asp-action="AddEvent" asp-route-id="@Model.Id" method="post" class="card card-body mt-3">
        <h3 class="h6">Yeni Kayıt</h3>
        @if (TempData["EventError"] is string eventError)
        {
            <div class="text-danger mb-2">@eventError</div>
        }
        <div class="row g-2">
            <div class="col-md-6">
                <label for="type" class="form-label">İşlem Türü</label>
                <select id="type" name="type" class="form-select" asp-items="ViewBag.EventTypes"></select>
            </div>
            <div class="col-md-6">
                <label for="eventDate" class="form-label">İşlem Tarihi</label>
                <input id="eventDate" name="eventDate" type="date" class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12">
                <label for="description" class="form-label">Açıklama</label>
                <textarea id="description" name="description" class="form-control" rows="2" maxlength="500" required
                          placeholder="Örn. RAM 8 GB'tan 16 GB'a yükseltildi.">@TempData["EventDraft"]</textarea>
            </div>
        </div>
        <div class="mt-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>
    </form>
</section>