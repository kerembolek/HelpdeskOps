@model HelpdeskOps.Models.Device

@{
    ViewData["Title"] = "Cihaz Detayı";
}

<h1>Cihaz Detayı</h1>

<hr />
<dl class="row">
    <dt class="col-sm-3">Cihaz Adı</dt>
    <dd class="col-sm-9">@Model.Hostname</dd>

    <dt class="col-sm-3">IP Adresi</dt>
    <dd class="col-sm-9">@Model.IpAddress</dd>

    <dt class="col-sm-3">Seri No</dt>
    <dd class="col-sm-9">@Model.SerialNumber</dd>

    <dt class="col-sm-3">Marka</dt>
    <dd class="col-sm-9">@Model.Brand</dd>

    <dt class="col-sm-3">Model</dt>
    <dd class="col-sm-9">@Model.Model</dd>

    <dt class="col-sm-3">Tür</dt>
    <dd class="col-sm-9">@Model.DeviceType</dd>

    <dt class="col-sm-3">Durum</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Garanti Bitişi</dt>
    <dd class="col-sm-9">@Model.WarrantyEndDate?.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Zimmetli Kullanıcı</dt>
    <dd class="col-sm-9">
        @(Model.AssignedUser != null
            ? $"{Model.AssignedUser.FirstName} {Model.AssignedUser.LastName}"
            : "Atanmamış")
    </dd>

    <dt class="col-sm-3">Oluşturulma Tarihi</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Son Güncelleme</dt>
    <dd class="col-sm-9">@Model.LastUpdated.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a> |
    <a asp-action="Index">Listeye Dön</a>
</div>