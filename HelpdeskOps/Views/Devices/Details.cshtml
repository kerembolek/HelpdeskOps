@model HelpdeskOps.Models.Device

@{
    ViewData["Title"] = "Cihaz Detayı";
}

@functions {
    // Pads port numbers so Gi1/0/2 sorts before Gi1/0/10
    private static string PortSortKey(string? port) =>
        System.Text.RegularExpressions.Regex.Replace(port ?? "", @"\d+", m => m.Value.PadLeft(4, '0'));
}

<h1>Cihaz Detayı</h1>

<hr />
<dl class="row">
    <dt class="col-sm-3">Cihaz Adı</dt>
    <dd class="col-sm-9">@Model.Hostname</dd>

    <dt class="col-sm-3">IP Adresi</dt>
    <dd class="col-sm-9"><partial name="_PingDot" model="Model" />@Model.IpAddress</dd>

    <dt class="col-sm-3">Seri No</dt>
    <dd class="col-sm-9">@Model.SerialNumber</dd>

    <dt class="col-sm-3">Marka</dt>
    <dd class="col-sm-9">@Model.Brand</dd>

    <dt class="col-sm-3">Model</dt>
    <dd class="col-sm-9">@Model.Model</dd>

    <dt class="col-sm-3">Tür</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.DeviceType)</dd>

    <dt class="col-sm-3">Durum</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>

    <dt class="col-sm-3">Satın Alma Tarihi</dt>
    <dd class="col-sm-9">@(Model.PurchaseDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

    <dt class="col-sm-3">Garanti Bitişi</dt>
    <dd class="col-sm-9"><partial name="_WarrantyBadge" model="Model" /></dd>

    <dt class="col-sm-3">Servis / Tedarikçi</dt>
    <dd class="col-sm-9">
        @if (string.IsNullOrEmpty(Model.VendorName) && string.IsNullOrEmpty(Model.VendorPhone) && string.IsNullOrEmpty(Model.VendorEmail))
        {
            <span class="text-muted">-</span>
        }
        else
        {
            <div>@Model.VendorName</div>
            @if (!string.IsNullOrEmpty(Model.VendorPhone))
            {
                <div><a href="tel:@Model.VendorPhone">@Model.VendorPhone</a></div>
            }
            @if (!string.IsNullOrEmpty(Model.VendorEmail))
            {
                <div><a href="mailto:@Model.VendorEmail">@Model.VendorEmail</a></div>
            }
        }
    </dd>

    <dt class="col-sm-3">Zimmetli Kullanıcı</dt>
    <dd class="col-sm-9">
        @(Model.AssignedUser != null
            ? $"{Model.AssignedUser.FirstName} {Model.AssignedUser.LastName}"
            : "Atanmamış")
    </dd>

    @if (Model.Switch != null)
    {
        <dt class="col-sm-3">Switch / Port</dt>
        <dd class="col-sm-9">
            <a asp-action="Details" asp-route-id="@Model.Switch.Id">@Model.Switch.Hostname</a>
            <span class="font-monospace ms-1">@Model.SwitchPort</span>
            @if (Model.VlanId != null)
            {
                <span class="badge text-bg-light border ms-1">VLAN @Model.VlanId</span>
            }
        </dd>
    }

    <dt class="col-sm-3">Oluşturulma Tarihi</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Son Güncelleme</dt>
    <dd class="col-sm-9">@Model.LastUpdated.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Düzenle</a>
    @if (Model!.SupportsRemoteDesktop())
    {
        <a asp-action="Rdp" asp-route-id="@Model.Id" class="btn btn-outline-primary ms-2">Uzak Masaüstü (RDP)</a>
    }
    <a asp-controller="Audit" asp-action="Index" asp-route-entityType="Device" asp-route-entityId="@Model.Id" class="btn btn-outline-secondary ms-2"><i class="bi bi-journal-text me-1"></i>Denetim Kaydı</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Listeye Dön</a>
</div>

@if (Model.DeviceType == HelpdeskOps.Models.Enums.DeviceType.Switch)
{
    <section id="ports" class="mt-5">
        <h2 class="h4">Port Tablosu</h2>
        <p class="text-muted small">Bu switch'e bağlı cihazlar. Bağlantılar cihazın düzenleme ekranından yapılır.</p>

        @if (!Model.ConnectedDevices.Any())
        {
            <div class="alert alert-info">Bu switch'e henüz bağlı cihaz yok.</div>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Port</th>
                        <th>VLAN</th>
                        <th>Cihaz Adı</th>
                        <th>IP Adresi</th>
                        <th>Tür</th>
                        <th>Zimmetli</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ConnectedDevices.OrderBy(d => PortSortKey(d.SwitchPort)))
                    {
                        <tr>
                            <td class="font-monospace">@item.SwitchPort</td>
                            <td>@(item.VlanId?.ToString() ?? "-")</td>
                            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.Id">@item.Hostname</a></td>
                            <td class="text-nowrap"><partial name="_PingDot" model="item" />@item.IpAddress</td>
                            <td>@Html.DisplayFor(_ => item.DeviceType)</td>
                            <td>@(item.AssignedUser != null ? $"{item.AssignedUser.FirstName} {item.AssignedUser.LastName}" : "Atanmamış")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<section id="assignment-forms" class="mt-5">
    <h2 class="h4">Zimmet Formları</h2>
    <p class="text-muted small">Cihaz bir kişiye her zimmetlendiğinde form açılır; kişi "Cihazlarım" sayfasından imzalayarak teslim aldığını onaylar. İade edilen cihazı kontrol edip "Teslim Al" ile imzalayın.</p>

    @if (TempData["FormMessage"] is string formMessage)
    {
        <div class="alert alert-success">@formMessage</div>
    }

    @if (ViewBag.AssignmentForms is not List<HelpdeskOps.Models.AssignmentForm> forms || !forms.Any())
    {
        <div class="alert alert-info">Bu cihaz için henüz zimmet formu bulunmuyor.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Form No</th>
                    <th>Zimmetlenen</th>
                    <th>Teslim Tarihi</th>
                    <th>Teslim Eden</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var form in forms)
                {
                    <tr>
                        <td>@form.FormNumber</td>
                        <td>@form.EmployeeName @(form.Department != null ? $"({form.Department})" : "")</td>
                        <td>@form.IssuedAt.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(form.IssuedByName ?? "-")</td>
                        <td><partial name="_AssignmentFormStatus" model="form" /></td>
                        <td>
                            @if (form.ReturnedAt == null)
                            {
                                <a asp-controller="AssignmentForms" asp-action="CheckIn" asp-route-id="@form.Id" class="btn btn-sm @(form.ReturnRequestedAt != null ? "btn-success" : "btn-outline-secondary") me-2">Teslim Al</a>
                            }
                            <a asp-controller="AssignmentForms" asp-action="Pdf" asp-route-id="@form.Id">PDF İndir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section id="history" class="mt-5" style="max-width: 48rem;">
    <h2 class="h4">Cihaz Geçmişi</h2>
    <p class="text-muted small">Format, yükseltme, parça değişimi ve bakım kayıtları ile zimmet, durum ve port değişiklikleri.</p>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">Bu cihaz için henüz kayıtlı bir işlem yok.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var item in Model.Events)
            {
                var isAutomatic = item.Type is HelpdeskOps.Models.Enums.DeviceEventType.AssignmentChanged
                    or HelpdeskOps.Models.Enums.DeviceEventType.StatusChanged
                    or HelpdeskOps.Models.Enums.DeviceEventType.PortChanged;
                <li class="list-group-item px-0">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>
                            <span class="badge @(isAutomatic ? "text-bg-light border" : "text-bg-primary")">@Html.DisplayFor(_ => item.Type)</span>
                            <span class="ms-1">@(item.PerformedBy != null ? $"{item.PerformedBy.FirstName} {item.PerformedBy.LastName}" : "Sistem")</span>
                        </span>
                        <span>@item.EventDate.ToTurkeyTime().ToString("dd.MM.yyyy")</span>
                    </div>
                    <div style="white-space: pre-line;">@item.Description</div>
                </li>
            }
        </ul>
    }

    <form asp-action="AddEvent" asp-route-id="@Model.Id" method="post" class="card card-body mt-3">
        <h3 class="h6">Yeni Kayıt</h3>
        @if (TempData["EventError"] is string eventError)
        {
            <div class="text-danger mb-2">@eventError</div>
        }
        <div class="row g-2">
            <div class="col-md-6">
                <label for="type" class="form-label">İşlem Türü</label>
                <select id="type" name="type" class="form-select" asp-items="ViewBag.EventTypes"></select>
            </div>
            <div class="col-md-6">
                <label for="eventDate" class="form-label">İşlem Tarihi</label>
                <input id="eventDate" name="eventDate" type="date" class="form-control"
                       value="@TurkeyTime.Today.ToString("yyyy-MM-dd")" max="@TurkeyTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12">
                <label for="description" class="form-label">Açıklama</label>
                <textarea id="description" name="description" class="form-control" rows="2" maxlength="500" required
                          placeholder="Örn. RAM 8 GB'tan 16 GB'a yükseltildi.">@TempData["EventDraft"]</textarea>
            </div>
        </div>
        <div class="mt-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>
    </form>
</section>