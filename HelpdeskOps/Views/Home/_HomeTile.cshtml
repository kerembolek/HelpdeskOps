@model HelpdeskOps.Models.HomeTile

<div class="col-sm-6 col-lg-4 col-xl-3">
    <a href="@Model.Url" class="card tile h-100 text-decoration-none">
        <div class="card-body d-flex align-items-start gap-3">
            <span class="icon-box bg-@Model.Color-subtle text-@Model.Color-emphasis"><i class="bi bi-@Model.Icon"></i></span>
            <div class="flex-grow-1">
                <div class="fw-semibold text-body">@Model.Title</div>
                <div class="small text-muted">@Model.Description</div>
            </div>
            @if (Model.Count is int count)
            {
                <span class="fs-3 fw-semibold text-body lh-1">@count</span>
            }
        </div>
    </a>
</div>
