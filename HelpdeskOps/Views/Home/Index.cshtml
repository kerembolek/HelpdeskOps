@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center py-5">
    <h1 class="display-5">HelpdeskOps</h1>
    <p class="lead">Kurumsal BT envanter ve destek talebi yönetim sistemi</p>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        @if (User.IsInRole("ITAdmin"))
        {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Pano</a>
        <a asp-controller="Devices" asp-action="Index" class="btn btn-primary">Cihazlar</a>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
        <a asp-controller="MyDevices" asp-action="Index" class="btn btn-primary">Cihazlarım</a>
        <a asp-controller="Solutions" asp-action="Index" class="btn btn-primary">Kendin Çöz</a>
        }

        <a asp-controller="Tickets" asp-action="Index" class="btn btn-primary">Talepler</a>
    </div>
</div>
