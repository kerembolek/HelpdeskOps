@using Microsoft.AspNetCore.Identity
@using HelpdeskOps.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<HelpdeskOps.Services.CompanyDirectory.DirectoryOptions> DirectoryOptions

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        @* On mid-size screens only the icon shows, so the IT menu fits on one line *@
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@User.Identity?.Name">
            <i class="bi bi-person-circle"></i> <span class="d-xl-none d-xxl-inline">@User.Identity?.Name</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            @* The read-only demo keeps account pages closed, so the link would only bounce *@
            @if (!HelpdeskOps.Services.DemoReadOnlyMiddleware.IsEnabled(Configuration))
            {
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-gear me-2"></i>Hesabım</a>
                </li>
            }
            @* Both pages read only (a retention run is refused like any other write), so IT can open them on the read-only demo too *@
            @if (User.IsInRole("ITAdmin"))
            {
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Audit" asp-action="Index"><i class="bi bi-journal-text me-2"></i>Denetim Kaydı</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Retention" asp-action="Index"><i class="bi bi-hourglass-split me-2"></i>Saklama Süreleri</a>
                </li>
            }
            @if (!HelpdeskOps.Services.DemoReadOnlyMiddleware.IsEnabled(Configuration) || User.IsInRole("ITAdmin"))
            {
                <li><hr class="dropdown-divider" /></li>
            }
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    @* The read-only demo has no registration, and with a company directory accounts come from the directory *@
    @if (!HelpdeskOps.Services.DemoReadOnlyMiddleware.IsEnabled(Configuration) && !DirectoryOptions.Value.IsEnabled)
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus"></i> Kayıt Ol</a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
    </li>
}
</ul>
