@using Microsoft.AspNetCore.Identity
@using HelpdeskOps.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject IConfiguration Configuration

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        @* On mid-size screens only the icon shows, so the IT menu fits on one line *@
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@User.Identity?.Name">
            <i class="bi bi-person-circle"></i> <span class="d-xl-none d-xxl-inline">@User.Identity?.Name</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    @* The read-only demo has no registration *@
    @if (!HelpdeskOps.Services.DemoReadOnlyMiddleware.IsEnabled(Configuration))
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus"></i> Kayıt Ol</a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
    </li>
}
</ul>
