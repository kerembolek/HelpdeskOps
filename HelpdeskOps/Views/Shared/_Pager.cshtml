@model HelpdeskOps.Models.IPagedList
@using Microsoft.AspNetCore.Http.Extensions
@{
    // Page links keep the current filters: only the page value of the query string changes
    string PageUrl(int page)
    {
        var query = new QueryBuilder(Context.Request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string>(q.Key, v ?? ""))));
        if (page > 1)
        {
            query.Add("page", page.ToString());
        }
        return Context.Request.Path + query.ToQueryString();
    }
}

@if (Model.PageCount > 1)
{
    <nav aria-label="Sayfalar">
        <ul class="pagination flex-wrap">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page - 1)">Önceki</a></li>
            @if (Model.Page > 3)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                @if (Model.Page > 4)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.PageCount, Model.Page + 2); p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
            }
            @if (Model.Page < Model.PageCount - 2)
            {
                @if (Model.Page < Model.PageCount - 3)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item"><a class="page-link" href="@PageUrl(Model.PageCount)">@Model.PageCount</a></li>
            }
            <li class="page-item @(Model.Page == Model.PageCount ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page + 1)">Sonraki</a></li>
        </ul>
    </nav>
}
