@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpdeskOps</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpdeskOps.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // Highlights the menu entry of the current section
        var currentController = ViewContext.RouteData.Values["controller"] as string;
        string Active(string controller) =>
            string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? " active" : "";
    }
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark app-navbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-headset"></i> HelpdeskOps
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Visitors get only the brand link home; every section below needs a signed-in user *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        <li class="nav-item">
                            <a class="nav-link@(Active("Home"))" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Ana Sayfa</a>
                        </li>
                        }

                        @if (User.IsInRole("ITAdmin") || User.IsInRole("Manager"))
                        {
                        <li class="nav-item">
                            <a class="nav-link@(Active("Dashboard"))" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Pano</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link@(Active("Reports"))" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Raporlar</a>
                        </li>
                        }

                        @if (User.IsInRole("ITAdmin"))
                        {
                        <li class="nav-item">
                            <a class="nav-link@(Active("Devices"))" asp-controller="Devices" asp-action="Index"><i class="bi bi-pc-display"></i> Cihazlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link@(Active("Users"))" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Kullanıcılar</a>
                        </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        <li class="nav-item">
                            <a class="nav-link@(Active("MyDevices"))" asp-controller="MyDevices" asp-action="Index"><i class="bi bi-laptop"></i> Cihazlarım</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link@(Active("Solutions"))" asp-controller="Solutions" asp-action="Index"><i class="bi bi-lightbulb"></i> Kendin Çöz</a>
                        </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        <li class="nav-item">
                            <a class="nav-link@(Active("Tickets"))" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-detailed"></i> Talepler</a>
                        </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                @await Component.InvokeAsync("NotificationBell")
                            </li>
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (HelpdeskOps.Services.DemoReadOnlyMiddleware.IsEnabled(Configuration))
        {
            <div class="alert alert-info py-2 small d-flex align-items-center gap-2">
                <i class="bi bi-eye"></i>
                <span><strong>Demo modu:</strong> tüm ekranları gezebilirsiniz; değişiklikler kaydedilmez.</span>
            </div>
        }
        @if (TempData[HelpdeskOps.Services.DemoReadOnlyMiddleware.MessageKey] is string demoMessage)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2">
                <i class="bi bi-lock"></i>
                <span>@demoMessage</span>
            </div>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Component.InvokeAsync("PrivacyNotice")
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - HelpdeskOps - <a asp-area="" asp-controller="Home" asp-action="Privacy">KVKK Aydınlatma Metni</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>