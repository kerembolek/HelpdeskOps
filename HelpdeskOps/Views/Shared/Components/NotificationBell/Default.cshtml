@model int

<a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index"
   aria-label="Bildirimler@(Model > 0 ? $", {Model} okunmamış" : "")" title="Bildirimler">
    <i class="bi bi-bell@(Model > 0 ? "-fill" : "")"></i>
    <span class="d-lg-none">Bildirimler</span>
    @if (Model > 0)
    {
        <span class="badge rounded-pill text-bg-danger">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
