<div class="alert alert-primary d-flex flex-wrap align-items-center justify-content-between gap-2">
    <span>
        <i class="bi bi-shield-check me-1"></i>
        Kişisel verilerinizin nasıl işlendiğini anlatan <a asp-area="" asp-controller="Home" asp-action="Privacy" class="alert-link">KVKK Aydınlatma Metni</a>'ni okuyun.
    </span>
    <form asp-area="" asp-controller="Home" asp-action="AcknowledgePrivacy" method="post" class="m-0">
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check2 me-1"></i>Okudum, anladım</button>
    </form>
</div>
