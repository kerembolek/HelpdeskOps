@using HelpdeskOps.Models
@using HelpdeskOps.Models.Enums
@model HelpdeskOps.Models.DashboardViewModel

@{
    ViewData["Title"] = "Pano";
    var maxDepartmentTickets = Model.DepartmentWorkload.Select(d => d.TotalTickets).DefaultIfEmpty(0).Max();
    // Managers see the warranty counts but the device list is for IT staff only
    var canOpenDevices = User.IsInRole("ITAdmin");
}

@functions {
    private static string FormatDuration(double minutes) => HelpdeskOps.Models.DurationFormat.FromMinutes(minutes);
}

<h1><i class="bi bi-speedometer2 text-primary me-2"></i>Pano</h1>

<p class="text-muted">Destek talepleri ve cihazlar için özet raporlar.</p>

@if (Model.TotalTickets == 0)
{
    <div class="alert alert-info">Henüz kayıtlı talep bulunmuyor. Talepler oluşturuldukça raporlar burada görünecek.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <a asp-controller="Tickets" asp-action="Index" asp-route-status="Open" class="stretched-link text-muted small text-decoration-none">Açık</a>
                        <div class="fs-2 fw-semibold">@Model.OpenTickets</div>
                    </div>
                    <span class="icon-box bg-primary-subtle text-primary-emphasis"><i class="bi bi-circle"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <a asp-controller="Tickets" asp-action="Index" asp-route-status="InProgress" class="stretched-link text-muted small text-decoration-none">İşlemde</a>
                        <div class="fs-2 fw-semibold">@Model.InProgressTickets</div>
                    </div>
                    <span class="icon-box bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <a asp-controller="Tickets" asp-action="Index" asp-route-scope="done" class="stretched-link text-muted small text-decoration-none">Çözülen / Kapatılan</a>
                        <div class="fs-2 fw-semibold">@Model.ResolvedTickets</div>
                    </div>
                    <span class="icon-box bg-success-subtle text-success-emphasis"><i class="bi bi-check-circle"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 @(Model.UnassignedActiveTickets > 0 ? "border-warning" : "")">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <a asp-controller="Tickets" asp-action="Index" asp-route-scope="unassigned" class="stretched-link text-muted small text-decoration-none">Atanmamış Aktif Talep</a>
                        <div class="fs-2 fw-semibold">@Model.UnassignedActiveTickets</div>
                    </div>
                    <span class="icon-box bg-warning-subtle text-warning-emphasis"><i class="bi bi-inbox"></i></span>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-muted small">Ortalama Çözüm Süresi</div>
                        <div class="fs-2 fw-semibold">
                            @(Model.AverageResolutionMinutes is double avg ? FormatDuration(avg) : "-")
                        </div>
                    </div>
                    <span class="icon-box bg-info-subtle text-info-emphasis"><i class="bi bi-stopwatch"></i></span>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5">Hedef Çözüm Süreleri (SLA)</h2>
    <p class="text-muted small">
        Hedefler oluşturulma anından itibaren: Kritik @TicketSla.TargetHours(TicketPriority.Critical) saat,
        Yüksek @TicketSla.TargetHours(TicketPriority.High) saat, Orta @TicketSla.TargetHours(TicketPriority.Medium) saat,
        Düşük @TicketSla.TargetHours(TicketPriority.Low) saat.
    </p>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card h-100 @(Model.OverdueTickets > 0 ? "border-danger" : "")">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <a asp-controller="Tickets" asp-action="Index" asp-route-scope="overdue" class="stretched-link text-muted small text-decoration-none">Hedef Süresi Geçen Aktif Talep</a>
                        <div class="fs-2 fw-semibold">@Model.OverdueTickets</div>
                    </div>
                    <span class="icon-box bg-danger-subtle text-danger-emphasis"><i class="bi bi-alarm"></i></span>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-muted small">Hedefinde Çözülme Oranı</div>
                        <div class="fs-2 fw-semibold">@(Model.SlaComplianceRate is double rate ? $"%{rate:0}" : "-")</div>
                    </div>
                    <span class="icon-box bg-success-subtle text-success-emphasis"><i class="bi bi-bullseye"></i></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="h5">Önceliğe Göre Çözüm Süresi</h2>
            @if (!Model.ResolutionByPriority.Any())
            {
                <div class="alert alert-info">Henüz çözülmüş talep bulunmuyor.</div>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Öncelik</th>
                            <th class="text-end">Çözülen Talep</th>
                            <th class="text-end">Ortalama Süre</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ResolutionByPriority)
                        {
                            <tr>
                                <td><partial name="_TicketPriorityBadge" model="row.Priority" /></td>
                                <td class="text-end">@row.ResolvedCount</td>
                                <td class="text-end">@FormatDuration(row.AverageMinutes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="col-lg-6">
            <h2 class="h5">Departman İş Yükü</h2>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Departman</th>
                        <th class="w-50">Toplam Talep</th>
                        <th class="text-end">Aktif</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.DepartmentWorkload)
                    {
                        var percent = maxDepartmentTickets == 0 ? 0 : row.TotalTickets * 100 / maxDepartmentTickets;
                        <tr>
                            <td>@row.Department</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" role="progressbar" aria-label="@row.Department toplam talep"
                                         aria-valuenow="@row.TotalTickets" aria-valuemin="0" aria-valuemax="@maxDepartmentTickets">
                                        <div class="progress-bar" style="width: @percent%"></div>
                                    </div>
                                    <span>@row.TotalTickets</span>
                                </div>
                            </td>
                            <td class="text-end">@row.ActiveTickets</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-12">
            <h2 class="h5">Kronik Sorunlu Cihazlar</h2>
            <p class="text-muted small">Cihaza bağlı talepler marka ve modele göre gruplanır; en çok talep alan @Model.ProblemDevices.Count model listelenir.</p>
            @if (!Model.ProblemDevices.Any())
            {
                <div class="alert alert-info">Henüz bir cihaza bağlı talep bulunmuyor.</div>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Marka</th>
                            <th>Model</th>
                            <th class="text-end">Talep Sayısı</th>
                            <th class="text-end">Etkilenen Cihaz</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ProblemDevices)
                        {
                            <tr>
                                <td>@row.Brand</td>
                                <td>@row.Model</td>
                                <td class="text-end">@row.TicketCount</td>
                                <td class="text-end">@row.DeviceCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<h2 class="h5 mt-4">Cihaz Garantileri</h2>
<p class="text-muted small">Hizmet dışı cihazlar sayılmaz.</p>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100 @(Model.ExpiringWarrantyDevices > 0 ? "border-warning" : "")">
            <div class="card-body">
                @if (canOpenDevices)
                {
                    <a asp-controller="Devices" asp-action="Index" asp-route-warranty="expiring" class="stretched-link text-muted small text-decoration-none">@HelpdeskOps.Models.Device.WarrantyExpiringSoonDays Gün İçinde Bitecek</a>
                }
                else
                {
                    <div class="text-muted small">@HelpdeskOps.Models.Device.WarrantyExpiringSoonDays Gün İçinde Bitecek</div>
                }
                <div class="fs-2 fw-semibold">@Model.ExpiringWarrantyDevices</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 @(Model.ExpiredWarrantyDevices > 0 ? "border-danger" : "")">
            <div class="card-body">
                @if (canOpenDevices)
                {
                    <a asp-controller="Devices" asp-action="Index" asp-route-warranty="expired" class="stretched-link text-muted small text-decoration-none">Garantisi Bitmiş</a>
                }
                else
                {
                    <div class="text-muted small">Garantisi Bitmiş</div>
                }
                <div class="fs-2 fw-semibold">@Model.ExpiredWarrantyDevices</div>
            </div>
        </div>
    </div>
</div>
