@using HelpdeskOps.Models.Enums
@model List<HelpdeskOps.Models.SolutionArticle>

@{
    ViewData["Title"] = "Kendin Çöz";
    var category = ViewBag.Category as TicketCategory?;
    var articleCounts = (Dictionary<TicketCategory, int>)ViewBag.ArticleCounts;
}

<h1>Kendin Çöz</h1>
<p class="text-muted">
    Talep açmadan önce sık karşılaşılan sorunların çözümlerini deneyin. Çoğu sorun birkaç dakikada çözülür;
    çözülmezse talep formu sizin için hazırlanır.
</p>

@if (User.IsInRole("ITAdmin"))
{
    <p><a asp-action="Manage" class="btn btn-outline-primary">Çözümleri Yönet</a></p>
}

@if (TempData["SolutionMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (category == null)
{
    <h2 class="h5 mt-4">Sorununuz hangi konuda?</h2>
    <div class="row g-3 mb-4">
        @foreach (var item in Enum.GetValues<TicketCategory>())
        {
            var count = articleCounts.GetValueOrDefault(item);
            <div class="col-6 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <a asp-action="Index" asp-route-category="@item" class="stretched-link fw-semibold text-decoration-none">@item.GetDisplayName()</a>
                        <div class="text-muted small">@(count > 0 ? $"{count} çözüm" : "Çözüm yok, doğrudan talep açın")</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <p class="text-muted small">
        Sorununuz listede yoksa <a asp-controller="Tickets" asp-action="Create">doğrudan talep oluşturabilirsiniz</a>.
    </p>
}
else
{
    <p>
        <a asp-action="Index">&larr; Tüm konular</a>
    </p>
    <h2 class="h5">@category.Value.GetDisplayName()</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Bu konu için henüz hazır bir çözüm yok.</div>
    }
    else
    {
        <div class="accordion mb-4" id="solutions">
            @foreach (var item in Model)
            {
                var collapseId = $"solution-{item.Id}";
                <div class="accordion-item">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            @item.Title
                        </button>
                    </h3>
                    <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#solutions">
                        <div class="accordion-body">
                            @if (!string.IsNullOrWhiteSpace(item.Symptoms))
                            {
                                <p class="text-muted"><strong>Belirtiler:</strong> @item.Symptoms</p>
                            }
                            <ol>
                                @foreach (var step in item.GetStepList())
                                {
                                    <li class="mb-1">@step</li>
                                }
                            </ol>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <form asp-action="Solved" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-success">Sorunum çözüldü</button>
                                </form>
                                <form asp-action="Escalate" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-outline-primary">Çözülmedi, talep aç</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <p>
        Sorununuz bunlardan farklıysa
        <a asp-controller="Tickets" asp-action="Create" asp-route-category="@category">bu konuda talep oluşturun</a>.
    </p>
}
