@model IEnumerable<HelpdeskOps.Models.Device>

@{
    ViewData["Title"] = "Cihazlarım";
}

<h1><i class="bi bi-laptop text-primary me-2"></i>Cihazlarım</h1>

<p class="text-muted">Size zimmetlenmiş cihazlar. Bir cihazla ilgili sorun yaşıyorsanız destek talebi oluşturabilirsiniz.</p>

<p>
    @if (User.IsInRole("ITAdmin"))
    {
        <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary">Yeni Talep Oluştur</a>
    }
    else
    {
        <a asp-controller="Solutions" asp-action="Index" class="btn btn-primary">Yeni Talep Oluştur</a>
    }
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Size zimmetlenmiş cihaz bulunmuyor.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Cihaz Adı</th>
                <th>Marka / Model</th>
                <th>Seri No</th>
                <th>Tür</th>
                <th>Durum</th>
                <th>Garanti Bitişi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Hostname</td>
                    <td>@item.Brand @item.Model</td>
                    <td>@item.SerialNumber</td>
                    <td>@Html.DisplayFor(modelItem => item.DeviceType)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    <td><partial name="_WarrantyBadge" model="item" /></td>
                </tr>
            }
        </tbody>
    </table>
}

<section id="assignment-forms" class="mt-5">
    <h2 class="h4">Zimmet Formlarım</h2>
    <p class="text-muted small">Size teslim edilen cihazların zimmet kayıtları. Cihazı teslim aldığınızda formu imzalayın; iade etmek istediğinizde buradan iade talebi gönderin.</p>

    @if (TempData["FormMessage"] is string formMessage)
    {
        <div class="alert alert-success">@formMessage</div>
    }

    @if (ViewBag.AssignmentForms is not List<HelpdeskOps.Models.AssignmentForm> forms || !forms.Any())
    {
        <div class="alert alert-info">Adınıza açılmış zimmet formu bulunmuyor.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Form No</th>
                    <th>Cihaz</th>
                    <th>Seri No</th>
                    <th>Teslim Tarihi</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var form in forms)
                {
                    <tr>
                        <td>@form.FormNumber</td>
                        <td>@form.Hostname <span class="text-muted small">@form.BrandModel</span></td>
                        <td>@form.SerialNumber</td>
                        <td>@form.IssuedAt.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td><partial name="_AssignmentFormStatus" model="form" /></td>
                        <td>
                            @if (form.AcceptedAt == null && form.ReturnedAt == null)
                            {
                                <a asp-action="Accept" asp-route-id="@form.Id" class="btn btn-sm btn-success">İmzala</a>
                            }
                            else if (form.AcceptedAt != null && form.ReturnedAt == null && form.ReturnRequestedAt == null)
                            {
                                <a asp-action="Return" asp-route-id="@form.Id" class="btn btn-sm btn-outline-primary">İade Et</a>
                            }
                            <a asp-controller="AssignmentForms" asp-action="Pdf" asp-route-id="@form.Id" class="btn btn-sm btn-outline-secondary">PDF İndir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
