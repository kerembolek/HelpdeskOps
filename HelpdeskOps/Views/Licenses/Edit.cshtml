@model SoftwareLicense

@{
    ViewData["Title"] = "Lisansı Düzenle";
}

<h1><i class="bi bi-key text-primary me-2"></i>@ViewData["Title"]</h1>

<div class="card mt-3" style="max-width: 40rem;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <partial name="_LicenseFields" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
