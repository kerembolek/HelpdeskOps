@model PagedList<LicenseListRow>

@{
    ViewData["Title"] = "Yazılım Lisansları";
    var renewal = ViewBag.Renewal as string;
    var userName = ViewBag.UserName as string;
    var isFiltered = renewal != null || userName != null;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1><i class="bi bi-key text-primary me-2"></i>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni Lisans</a>
</div>

<p class="text-muted">Şirketin satın aldığı lisanslar, kaç kişinin kullandığı ve yenileme tarihleri.</p>

@if (TempData["LicenseMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @(renewal == null ? "btn-secondary" : "btn-outline-secondary")">Tümü</a>
    <a asp-action="Index" asp-route-renewal="expiring" class="btn btn-sm @(renewal == "expiring" ? "btn-warning" : "btn-outline-warning")">30 gün içinde yenilenecek</a>
    <a asp-action="Index" asp-route-renewal="expired" class="btn btn-sm @(renewal == "expired" ? "btn-danger" : "btn-outline-danger")">Süresi dolan</a>
</div>

@if (userName != null)
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span><strong>@userName</strong> kişisine atanmış lisanslar</span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Filtreyi kaldır</a>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(isFiltered ? "Filtreye uyan lisans bulunamadı." : "Henüz lisans eklenmedi. Microsoft 365, muhasebe programı veya antivirüs gibi lisansları ekleyerek başlayın.")
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Lisans</th>
                <th>Üretici / Tedarikçi</th>
                <th>Kullanım</th>
                <th>Yenileme / Bitiş</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var percent = Math.Min(100, row.Used * 100 / row.Seats);
                <tr>
                    <td>@row.Name</td>
                    <td>@(row.Vendor ?? "-")</td>
                    <td style="min-width: 9rem;">
                        <div class="progress" style="height: .5rem;" role="progressbar" aria-label="Kullanılan kullanıcı hakkı" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(row.Used >= row.Seats ? "bg-warning" : "")" style="width: @percent%"></div>
                        </div>
                        <div class="small text-muted">@row.Used / @row.Seats kullanıcı@(row.Used >= row.Seats ? " · boş hak yok" : "")</div>
                    </td>
                    <td><partial name="_RenewalBadge" model="row.RenewalDate" /></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">Aç</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="(IPagedList)Model" />
}
