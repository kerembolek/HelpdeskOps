@using HelpdeskOps.Models.Enums
@model HelpdeskOps.Models.Ticket

@{
    ViewData["Title"] = "Yeni Destek Talebi";
}

<h1>Yeni Destek Talebi</h1>

<h4>Talep Bilgileri</h4>
<hr />
@if (ViewBag.TriedSolution is string triedSolution)
{
    <div class="alert alert-info">
        <strong>@triedSolution</strong> çözümünü denediğiniz talep formuna eklendi. Sorunu birkaç cümleyle anlatmanız yeterli.
    </div>
}
@if (ViewBag.ScannedDevice is string scannedDevice)
{
    <div class="alert alert-info">
        <i class="bi bi-qr-code me-1"></i><strong>@scannedDevice</strong> cihazının etiketini okuttunuz. Sorunu birkaç cümleyle anlatmanız yeterli.
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (User.IsInRole("ITAdmin"))
            {
                <div class="mb-3">
                    <label for="requesterId" class="form-label">Talep Eden</label>
                    <select id="requesterId" name="requesterId" class="form-select" asp-items="ViewBag.Requesters"></select>
                    <div class="form-text">Telefonla veya yüz yüze gelen talepleri kullanıcı adına açabilirsiniz.</div>
                    <span asp-validation-for="RequesterId" class="text-danger"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <partial name="_CategoryFields" />
            <div class="mb-3">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<TicketPriority>()"></select>
            </div>
            <div class="mb-3">
                <label asp-for="DeviceId" class="form-label"></label>
                <select asp-for="DeviceId" class="form-select" asp-items="ViewBag.DeviceId">
                    <option value="">Seçiniz</option>
                </select>
                <span asp-validation-for="DeviceId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="files" class="form-label">Ekler (isteğe bağlı)</label>
                <input id="files" name="files" type="file" class="form-control" multiple accept="@HelpdeskOps.Services.AttachmentStorage.AcceptList" />
                <div class="form-text">
                    Ekran görüntüsü veya hata kaydı eklemek sorunun daha hızlı çözülmesine yardımcı olur.
                    En fazla @HelpdeskOps.Services.AttachmentStorage.MaxFilesPerUpload dosya, her biri en fazla @(HelpdeskOps.Services.AttachmentStorage.MaxFileSize / (1024 * 1024)) MB.
                    Form hata verirse dosyaları yeniden seçmeniz gerekir.
                </div>
                @if (ViewData.ModelState["files"]?.Errors.FirstOrDefault() is { } fileError)
                {
                    <span class="text-danger">@fileError.ErrorMessage</span>
                }
            </div>
            <div class="mt-3">
                <input type="submit" value="Talep Oluştur" class="btn btn-primary" />
				<a asp-action="Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>
