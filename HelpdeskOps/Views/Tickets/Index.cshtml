@using HelpdeskOps.Models.Enums
@model IEnumerable<HelpdeskOps.Models.Ticket>

@{
    ViewData["Title"] = "Destek Talepleri";
    var scope = ViewBag.Scope as string;
    var isFiltered = (bool)ViewBag.IsFiltered;
    var categoryValue = (ViewBag.Category as TicketCategory?) is TicketCategory c ? ((int)c).ToString() : null;
    var statusValue = (ViewBag.Status as TicketStatus?) is TicketStatus s ? ((int)s).ToString() : null;
    var priorityValue = (ViewBag.Priority as TicketPriority?) is TicketPriority p ? ((int)p).ToString() : null;
    var categoryItems = new SelectList(Html.GetEnumSelectList<TicketCategory>(), "Value", "Text", categoryValue);
    var statusItems = new SelectList(Html.GetEnumSelectList<TicketStatus>(), "Value", "Text", statusValue);
    var priorityItems = new SelectList(Html.GetEnumSelectList<TicketPriority>(), "Value", "Text", priorityValue);
}

<h1><i class="bi bi-ticket-detailed text-primary me-2"></i>Destek Talepleri</h1>

<p>
    @if (User.IsInRole("ITAdmin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Yeni Talep Oluştur</a>
    }
    else
    {
        @* Employees try the Tier 0 solution bank first; the ticket form is one click away from there *@
        <a asp-controller="Solutions" asp-action="Index" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Yeni Talep Oluştur</a>
    }
</p>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label for="q" class="form-label small text-muted mb-1">Ara</label>
        <input id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Başlık veya açıklama" />
    </div>
    <div class="col-6 col-md-2">
        <label for="category" class="form-label small text-muted mb-1">Kategori</label>
        <select id="category" name="category" class="form-select" asp-items="categoryItems">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="status" class="form-label small text-muted mb-1">Durum</label>
        <select id="status" name="status" class="form-select" asp-items="statusItems">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="priority" class="form-label small text-muted mb-1">Öncelik</label>
        <select id="priority" name="priority" class="form-select" asp-items="priorityItems">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-md-2">
        <label for="scope" class="form-label small text-muted mb-1">Görünüm</label>
        <select id="scope" name="scope" class="form-select">
            <option value="">Tüm talepler</option>
            <option value="active" selected="@(scope == "active")">Aktif talepler</option>
            <option value="done" selected="@(scope == "done")">Çözülen / Kapatılan</option>
            <option value="overdue" selected="@(scope == "overdue")">Hedef süresi geçenler</option>
            @if (User.IsInRole("ITAdmin"))
            {
                <option value="mine" selected="@(scope == "mine")">Bana atananlar</option>
            }
            @if (User.IsInRole("ITAdmin") || User.IsInRole("Manager"))
            {
                <option value="unassigned" selected="@(scope == "unassigned")">Atanmamış aktif talepler</option>
            }
        </select>
    </div>
    <div class="col-md-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrele</button>
        @if (isFiltered)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(isFiltered ? "Filtreye uyan talep bulunamadı." : "Henüz kayıtlı talep bulunmuyor.")
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Category)</th>
                <th>@Html.DisplayNameFor(model => model.Priority)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>Hedef Süre</th>
                <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                <th>@Html.DisplayNameFor(model => model.Device)</th>
                <th>@Html.DisplayNameFor(model => model.Requester)</th>
                <th>@Html.DisplayNameFor(model => model.AssignedTo)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@item.CategoryPath</td>
                    <td><partial name="_TicketPriorityBadge" model="item.Priority" /></td>
                    <td><partial name="_TicketStatusBadge" model="item.Status" /></td>
                    <td><partial name="_SlaBadge" model="item" /></td>
                    <td>@item.CreatedAt.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(item.Device?.Hostname ?? "-")</td>
                    <td>@(item.Requester != null ? item.Requester.FirstName + " " + item.Requester.LastName : "-")</td>
                    <td>@(item.AssignedTo != null ? item.AssignedTo.FirstName + " " + item.AssignedTo.LastName : "Atanmadı")</td>
                    <td>
                        @if (User.IsInRole("ITAdmin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a> <text>|</text>
                            <a asp-action="Details" asp-route-id="@item.Id">Detaylar</a> <text>|</text>
                            <a asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                            @if (item.AssignedToId == null && item.Status is TicketStatus.Open or TicketStatus.InProgress)
                            {
                                <form asp-action="AssignToMe" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Üzerime Al</button>
                                </form>
                            }
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.Id">Detaylar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}