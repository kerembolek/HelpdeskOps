@model ApplicationUser
@{
    ViewData["Title"] = "Kullanıcıyı Anonimleştir";
    var blocker = ViewBag.Blocker as string;
}

<h1><i class="bi bi-person-slash text-danger me-2"></i>@ViewData["Title"]</h1>
<p class="text-muted">KVKK kapsamında silme talebi veya şirketten ayrılan çalışan için.</p>

@if (TempData["UserError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card" style="max-width: 46rem;">
    <div class="card-body p-4">
        <h2 class="h5 mb-1">@Model.FirstName @Model.LastName</h2>
        <p class="text-muted small">@Model.Email · @(Model.Department ?? "Departman yok")</p>

        <h3 class="h6 mt-4">Silinecekler</h3>
        <ul class="small">
            <li>Ad, soyad, e-posta, telefon ve departman. Hesap "@HelpdeskOps.Services.Kvkk.PersonalDataAnonymizer.AnonymousName" adını alır.</li>
            <li>Şifre, iki adımlı doğrulama, rol ve bildirimler. Hesap kalıcı olarak kilitlenir, açık oturumları kapanır.</li>
            <li>Denetim kaydındaki IP adresleri ile adının ve e-postasının geçtiği yerler.</li>
        </ul>

        <h3 class="h6">Kalacaklar</h3>
        <ul class="small">
            <li>Açtığı @ViewBag.TicketCount talep, yorumları ve talep geçmişi "@HelpdeskOps.Services.Kvkk.PersonalDataAnonymizer.AnonymousName" adıyla kalır. Talep metinleri yazıldığı gibi durur.</li>
            <li>
                @ViewBag.FormCount zimmet formu adı ve imzasıyla saklanır, çünkü cihaz teslimini kanıtlar.
                Saklama süresi dolunca otomatik olarak anonimleştirilir.
            </li>
        </ul>

        @if (blocker != null)
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-1"></i>@blocker
            </div>
        }
        else
        {
            <div class="alert alert-danger small">Bu işlem geri alınamaz. Gerekirse önce kişinin verilerini indirip kendisine iletin.</div>
            <form asp-action="Anonymize" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-person-slash me-1"></i>Anonimleştir</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </form>
        }
    </div>
</div>

@if (blocker != null)
{
    <a asp-action="Index" class="btn btn-outline-secondary mt-3">Kullanıcılara Dön</a>
}
