@using HelpdeskOps.Models
@model IEnumerable<HelpdeskOps.Models.UserListRow>

@{
    ViewData["Title"] = "Kullanıcılar";
    var selectedRole = ViewBag.Role as string;
    var isFiltered = (bool)ViewBag.IsFiltered;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1><i class="bi bi-people text-primary me-2"></i>Kullanıcılar</h1>
    <a asp-controller="Checklists" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-person-check me-1"></i>İşe Giriş / İşten Çıkış</a>
</div>

<p class="text-muted">Sisteme kayıtlı kullanıcılar, rolleri, zimmetli cihaz sayıları ve üzerlerindeki aktif talepler.</p>

@if (TempData["UserMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["UserError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label for="q" class="form-label small text-muted mb-1">Ara</label>
        <input id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Ad, e-posta veya departman" />
    </div>
    <div class="col-md-3">
        <label for="role" class="form-label small text-muted mb-1">Rol</label>
        <select id="role" name="role" class="form-select">
            <option value="">Tümü</option>
            @foreach (var role in AppRoles.All)
            {
                <option value="@role" selected="@(role == selectedRole)">@AppRoles.DisplayName(role)</option>
            }
        </select>
    </div>
    <div class="col-md-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrele</button>
        @if (isFiltered)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(isFiltered ? "Filtreye uyan kullanıcı bulunamadı." : "Henüz kayıtlı kullanıcı bulunmuyor.")
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>E-posta</th>
                <th>Departman</th>
                <th>Rol</th>
                <th class="text-end">Zimmetli Cihaz</th>
                <th class="text-end">Üzerindeki Aktif Talep</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        @user.Name
                        @if (user.TwoFactorEnabled)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1" title="İki adımlı doğrulama açık"><i class="bi bi-shield-check"></i> 2FA</span>
                        }
                        @if (user.IsAnonymized)
                        {
                            <span class="badge text-bg-secondary ms-1" title="KVKK kapsamında kişisel verileri silindi"><i class="bi bi-person-slash"></i> Anonimleştirildi</span>
                        }
                        @if (user.IsLockedOut)
                        {
                            @if (user.IsClosed)
                            {
                                <span class="badge text-bg-dark ms-1" title="İşten çıkış listesi tamamlandı"><i class="bi bi-door-closed"></i> Hesap kapalı</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger ms-1"><i class="bi bi-lock"></i> Kilitli</span>
                            }
                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="btn btn-sm btn-link p-0 ms-1">@(user.IsClosed ? "Yeniden aç" : "Kilidi aç")</button>
                            </form>
                        }
                    </td>
                    <td>@user.Email</td>
                    <td>@(user.Department ?? "-")</td>
                    <td>
                        @if (user.Id == (string?)ViewBag.CurrentUserId)
                        {
                            @AppRoles.DisplayName(user.Role) <span class="text-muted small">(siz)</span>
                        }
                        else if (user.IsAnonymized)
                        {
                            <span class="text-muted">-</span>
                        }
                        else
                        {
                            <form asp-action="ChangeRole" asp-route-id="@user.Id" method="post" class="d-flex gap-2">
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <select name="role" class="form-select form-select-sm" style="min-width: 9rem;" aria-label="@user.Name rolü">
                                    @if (user.Role == null)
                                    {
                                        <option value="" selected>Rol yok</option>
                                    }
                                    @foreach (var role in AppRoles.All)
                                    {
                                        <option value="@role" selected="@(role == user.Role)">@AppRoles.DisplayName(role)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Kaydet</button>
                            </form>
                        }
                    </td>
                    <td class="text-end">@user.DeviceCount</td>
                    <td class="text-end">@user.ActiveTicketCount</td>
                    <td class="text-end text-nowrap">
                        @if (!user.IsAnonymized)
                        {
                            <a asp-controller="Checklists" asp-action="Create" asp-route-userId="@user.Id" asp-route-type="@ChecklistType.Onboarding"
                               class="btn btn-sm btn-outline-primary" title="İşe giriş listesi aç" aria-label="@user.Name için işe giriş listesi aç">
                                <i class="bi bi-person-plus"></i>
                            </a>
                            @if (user.Id != (string?)ViewBag.CurrentUserId)
                            {
                                <a asp-controller="Checklists" asp-action="Create" asp-route-userId="@user.Id" asp-route-type="@ChecklistType.Offboarding"
                                   class="btn btn-sm btn-outline-danger" title="İşten çıkış listesi aç" aria-label="@user.Name için işten çıkış listesi aç">
                                    <i class="bi bi-person-dash"></i>
                                </a>
                            }
                        }
                        <form asp-action="ExportData" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Kişisel verilerini indir (JSON)" aria-label="@user.Name kişisel verilerini indir">
                                <i class="bi bi-download"></i>
                            </button>
                        </form>
                        @if (!user.IsAnonymized && user.Id != (string?)ViewBag.CurrentUserId)
                        {
                            <a asp-action="Anonymize" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger" title="Anonimleştir" aria-label="@user.Name kullanıcısını anonimleştir">
                                <i class="bi bi-person-slash"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="(IPagedList)Model" />
}
