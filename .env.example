# Copy to .env (never commit .env) and fill in. docker compose reads it automatically.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits, and symbols
DB_PASSWORD=

# Port the app listens on, on this machine
APP_PORT=8080

# true only when a reverse proxy (such as Caddy) handles HTTPS in front of the app; then also set APP_PORT=127.0.0.1:8080
BEHIND_PROXY=false

# Register this address in the app, then restart the app container: it becomes the first IT staff member
INITIAL_ADMIN_EMAIL=

# Shown on the KVKK privacy notice; the company name is required
KVKK_CONTROLLER_NAME=
KVKK_CONTROLLER_ADDRESS=
KVKK_CONTACT_EMAIL=

# Working hours for SLA targets (Critical tickets count around the clock)
SLA_WORKDAY_START=09:00:00
SLA_WORKDAY_END=18:00:00

# E-mail: None (nothing is sent) or Smtp
EMAIL_MODE=None
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=helpdesk@sirketiniz.com.tr

# The site's public address, for links in mails sent in the background
APP_PUBLIC_URL=

# Opening tickets by e-mail: a dedicated helpdesk mailbox read over IMAP with TLS; leave IMAP_HOST empty to turn it off
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Teams: the webhook address of the IT channel, which also needs APP_PUBLIC_URL. Treat it like a password; leave empty to turn it off.
# docs/INSTALL_TR.md section 4.8 has the steps.
TEAMS_WEBHOOK_URL=

# Key the inventory agent (scripts/Send-Inventory.ps1) sends; leave empty to turn automatic inventory off.
# Use a long random value, e.g. from: openssl rand -hex 32
INVENTORY_API_KEY=

# Company directory: None, Entra, or ActiveDirectory. docs/INSTALL_TR.md section 4.6 has the steps.
DIRECTORY_PROVIDER=None
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# LDAPS only: a read-only service account, and the OU that holds real people
LDAP_HOST=
LDAP_PORT=636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
